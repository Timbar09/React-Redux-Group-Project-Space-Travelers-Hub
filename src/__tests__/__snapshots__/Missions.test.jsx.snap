            >
              <h1
                class="modal-title fs-5"
                id="waiverModalLabel"
              >
                Waiver of Liability
              </h1>
              <button
                aria-label=""
                class="_button_29f8d0 
       _tertiary_29f8d0 px-2 d-inline-flex align-items-center gap-2 rounded-1 "
                data-bs-dismiss="modal"
